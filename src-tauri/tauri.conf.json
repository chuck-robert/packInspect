{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PackInspect",
  "version": "0.1.0",
  "identifier": "dev.packinspect.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PackInspect",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark",
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "本地包环境扫描工具",
    "longDescription": "扫描本机 pip / npm / pnpm / yarn 等包管理器的已安装包、缓存占用与镜像源配置，支持导出报告与安全清理缓存。"
  },
  "plugins": {}
}
